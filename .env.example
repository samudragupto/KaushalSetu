# Used by the Prisma CLI at the repository root (migrate, seed, reset).
# Local: the docker-compose Postgres. Production: the Supabase connection POOLER in SESSION mode
# (host aws-0-ap-south-1.pooler.supabase.com, port 5432). Never use db.<ref>.supabase.co; it is
# IPv6-only and unreachable from Render.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaushalsetu
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/kaushalsetu
