# ---------------------------------------------------------------- required
# Postgres. Production: Supabase pooler, SESSION mode, port 5432, for BOTH variables:
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# If you ever switch to TRANSACTION mode (port 6543), append ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaushalsetu
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/kaushalsetu

# Long random string used to sign JWTs (Render can generate one).
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated allowlist of web origins. No wildcard. Include the Vercel production URL, any
# preview URLs you use, and http://localhost:5173 for development.
CORS_ORIGIN=http://localhost:5173

# Base URL used to build employer verification links. Defaults to the first CORS_ORIGIN.
PUBLIC_WEB_URL=http://localhost:5173

PORT=4000

# ---------------------------------------------------------------- demo behaviour
# true: one-click demo sign-in, simulation console, WhatsApp simulator, on-screen OTPs.
DEMO_MODE=true
# false disables node-cron jobs (keep-alive, follow-up scheduler, nightly fraud sweep).
CRON_ENABLED=true

# ---------------------------------------------------------------- Supabase Storage (optional)
# Without these, uploads are stored inline in Postgres (base64, 2 MB cap) and still work.
# The service role key stays on the API; the browser only ever receives signed URLs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=outcome-evidence

# ---------------------------------------------------------------- integration adapters (optional)
# Each adapter uses the real API when its key is set and a built-in simulation otherwise.
# AI skill-gap summary: Gemini is preferred when both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Meta WhatsApp Cloud API. Webhook: GET/POST {API}/api/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Any GST verification API that serves GET {GSTIN_API_URL}/{gstin} with an x-api-key header.
GSTIN_API_KEY=
GSTIN_API_URL=
# Bhashini (Dhruva) inference key for translating free-text replies into English.
BHASHINI_API_KEY=
