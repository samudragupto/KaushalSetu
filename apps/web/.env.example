# Base URL of the KaushalSetu API (the Render web service). No trailing slash.
# Local development: http://localhost:4000
VITE_API_URL=http://localhost:4000

# Optional: Supabase Realtime as an instant refresh trigger on top of 5-second polling.
# Use the project's ANON (public) key only. Never put the service role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
